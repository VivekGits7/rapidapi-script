# ==================== SERVER ====================
APP_NAME="RapidAPI Auto Parts Dumper"
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== CORS ====================
FRONTEND_URL=http://localhost:3000

# ==================== RAPIDAPI ====================
# Single-key mode (no rotation): set RAPIDAPI_KEY. Numbered RAPIDAPI_KEY_1, _2, ...
# also work if you ever want rotation.
RAPIDAPI_KEY=
RAPIDAPI_HOST=auto-parts-catalog.p.rapidapi.com
RAPIDAPI_BASE_URL=https://auto-parts-catalog.p.rapidapi.com
RAPIDAPI_TIMEOUT=30.0
# Plan limits — 20 requests/second, 100,000 requests/month (hard)
RAPIDAPI_RATE_LIMIT_PER_SEC=20
MONTHLY_REQUEST_HARD_LIMIT=100000
MONTHLY_REQUEST_SAFETY_BUFFER=500

# Locale used when fetching models/vehicles/categories
DEFAULT_LANG_ID=4
DEFAULT_COUNTRY_FILTER_ID=80
DEFAULT_TYPE_ID=1

# Bilingual English + Arabic (_ar columns)
BILINGUAL=true
ARABIC_LANG_ID=42

# Store-all, complete top-N (0 = all). ALL vehicles+articles stored; these gate the deep crawl/details.
MAX_VEHICLES_PER_MODEL=5
MAX_ARTICLES_PER_CATEGORY=5

# ==================== DATABASE ====================
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=autoparts
POSTGRES_DB_USER=autoparts
POSTGRES_DB_PASSWORD=

# ==================== AWS S3 CONFIGURATION ====================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
S3_ARTICLE_MEDIA_FOLDER=dev/article_media

# ==================== DUMP TUNING ====================
COOLDOWN_429_SEC=60
COOLDOWN_403_SEC=3600
COOLDOWN_5XX_SEC=10
KEY_EXHAUSTION_THRESHOLD_SEC=21600
MAX_TRANSIENT_RETRIES=3
# Retries for the flaky complete-details call before falling back to individual-details + compat-cars
COMPLETE_DETAILS_MAX_RETRIES=1
BATCH_SIZE=100

# ==================== TARGET FILTER ====================
DUMP_TARGETS_CSV=dump_targets.csv

# ==================== CATEGORY SKIP (optional; only filter is make+model) ====================
# ALL vehicles/categories/articles per targeted model are dumped. Optional skip list:
BLOCKED_CATEGORY_EXTERNAL_IDS=

# ==================== MEDIA + S3 MIRRORING ====================
MEDIA_ENABLED=false
S3_ENABLED=false
