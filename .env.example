# ==================== SERVER ====================
APP_NAME="RapidAPI Auto Parts Dumper"
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== CORS ====================
FRONTEND_URL=http://localhost:3000

# ==================== RAPIDAPI ====================
# Single-key mode (no rotation): set RAPIDAPI_KEY. Numbered RAPIDAPI_KEY_1, _2, ...
# also work if you ever want rotation.
RAPIDAPI_KEY=
RAPIDAPI_HOST=auto-parts-catalog.p.rapidapi.com
RAPIDAPI_BASE_URL=https://auto-parts-catalog.p.rapidapi.com
RAPIDAPI_TIMEOUT=30.0
# Plan limits — 100 requests/second, 1,000,000 requests/month (hard)
# MONTHLY_REQUEST_HARD_LIMIT=0 turns the monthly guard off, for a plan with no monthly cap
RAPIDAPI_RATE_LIMIT_PER_SEC=100
MONTHLY_REQUEST_HARD_LIMIT=1000000
MONTHLY_REQUEST_SAFETY_BUFFER=500

# Locale used when fetching models/vehicles/categories
DEFAULT_LANG_ID=4
DEFAULT_COUNTRY_FILTER_ID=80
DEFAULT_TYPE_ID=1

# Bilingual English + Arabic (_ar columns)
BILINGUAL=true
ARABIC_LANG_ID=42

# Store-all, complete top-N (0 = all). ALL vehicles+articles stored; these gate the deep crawl/details.
MAX_VEHICLES_PER_MODEL=5
MAX_ARTICLES_PER_CATEGORY=5

# Traversal strategy: depth_first (one manufacturer fully, then next — current) or
# breadth_first (all manufacturers → models → vehicles → categories → articles → details).
CRAWL_MODE=depth_first

# Fuel-type filter: variants whose EN/AR fuelType STARTS WITH any prefix are STORED/LISTED
# but flagged (is_fuel_excluded) and SKIPPED from the deep crawl (categories/articles/details)
# in both modes. Comma-sep, case-insensitive. Empty = deep-crawl all fuels. Default skips diesel.
VEHICLE_FUEL_EXCLUDE_PREFIXES=diesel,ديزل

# ==================== DATABASE ====================
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=autoparts
POSTGRES_DB_USER=autoparts
POSTGRES_DB_PASSWORD=

# ==================== AWS S3 CONFIGURATION ====================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
S3_ARTICLE_MEDIA_FOLDER=dev/article_media

# ==================== DUMP TUNING ====================
# 429 cooldown is short: the token bucket prevents 429s; a stray one must not stall all workers
COOLDOWN_429_SEC=5
COOLDOWN_403_SEC=3600
COOLDOWN_5XX_SEC=10
KEY_EXHAUSTION_THRESHOLD_SEC=21600
MAX_TRANSIENT_RETRIES=3
# Retries for the flaky complete-details call before falling back to individual-details + compat-cars
COMPLETE_DETAILS_MAX_RETRIES=1
# Short timeout for the flaky complete-details endpoint (healthy responses arrive in ~1s)
COMPLETE_DETAILS_TIMEOUT=12
BATCH_SIZE=100

# ==================== PARALLEL CRAWL ====================
# Workers = lanes (concurrent make/model targets); rate = global speed limit shared by ALL workers.
DUMP_WORKERS=8
DUMP_RATE_PER_SEC=90
LIST_FANOUT=8
DETAILS_FANOUT=4
KEY_FLUSH_INTERVAL_SEC=5
KEY_FLUSH_MAX_PENDING=200
HEARTBEAT_INTERVAL_SEC=5
POSTGRES_POOL_MAX=30
# Browse index build and link table backfill at dump start can take minutes on a big catalog.
SCHEMA_DDL_TIMEOUT=3600

# ==================== TARGET FILTER ====================
DUMP_TARGETS_CSV=dump_targets.csv

# ==================== CATEGORY SKIP (optional; only filter is make+model) ====================
# ALL vehicles/categories/articles per targeted model are dumped. Optional skip list:
BLOCKED_CATEGORY_EXTERNAL_IDS=

# ==================== MEDIA + S3 MIRRORING ====================
MEDIA_ENABLED=false
S3_ENABLED=false
